// Gunara.web.id — Prisma Schema
// Database untuk lead konsultasi & subscriber newsletter

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ContactLead {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  service   String?
  message   String
  status    String   @default("new")
  source    String   @default("website")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Cache terjemahan AI — 195 bahasa dunia.
// baseLang = kode bahasa dasar (ar, ja, fr, …); key = kunci UI; value = hasil terjemahan.
// Disimpan permanen agar setiap bahasa hanya diterjemahkan SEKALI oleh AI.
model TranslationCache {
  id        String   @id @default(cuid())
  baseLang  String
  key       String
  value     String
  updatedAt DateTime @updatedAt

  @@unique([baseLang, key])
  @@index([baseLang])
}
